# Copy to .env (gitignored). Only the deploy/e2e scripts read these; the website never sees secrets.

# Stellar testnet keys. Leave empty and `pnpm deploy:testnet` will generate, fund (Friendbot) and save them here.
MOCK_ISSUER_SECRET=
STELLAR_DEPLOYER_SECRET=

# EVM testnet deployer (needs ~0.05 Sepolia ETH). Leave empty and the script prints an address to fund.
EVM_DEPLOYER_PRIVATE_KEY=
# sepolia | arbitrum-sepolia
EVM_TESTNET=sepolia
# Optional RPC overrides
STELLAR_TESTNET_RPC=
EVM_RPC_URL=
