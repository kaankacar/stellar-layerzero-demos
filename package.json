{
  "name": "stellar-layerzero-demos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-demo site teaching LayerZero V2 on Stellar and USDT0: mainnet read-only inspectors plus a testnet OFT playground.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:registry": "tsx --tsconfig tsconfig.node.json scripts/verify-registry.ts",
    "build:wasm": "bash scripts/build-wasm.sh",
    "compile:evm": "tsx --tsconfig tsconfig.node.json scripts/compile-evm.ts",
    "deploy:testnet": "tsx --tsconfig tsconfig.node.json scripts/deploy-testnet.ts",
    "e2e:testnet": "tsx --tsconfig tsconfig.node.json scripts/e2e-testnet-send.ts"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.6.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "buffer": "^6.0.3",
    "framer-motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.0"
  }
}
